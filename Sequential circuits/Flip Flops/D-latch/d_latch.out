#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5a4e2dc98c30 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5a4e2dc98dc0 .scope module, "testb_d_latch" "testb_d_latch" 3 1;
 .timescale 0 0;
v0x5a4e2dcaaf00_0 .var "D", 0 0;
v0x5a4e2dcaafd0_0 .var "EN", 0 0;
v0x5a4e2dcab0a0_0 .net "Q", 0 0, v0x5a4e2dcaade0_0;  1 drivers
S_0x5a4e2dc5f490 .scope module, "uut" "d_latch" 3 6, 4 1 0, S_0x5a4e2dc98dc0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "D";
    .port_info 1 /INPUT 1 "EN";
    .port_info 2 /OUTPUT 1 "Q";
v0x5a4e2dc5f6e0_0 .net "D", 0 0, v0x5a4e2dcaaf00_0;  1 drivers
v0x5a4e2dcaad20_0 .net "EN", 0 0, v0x5a4e2dcaafd0_0;  1 drivers
v0x5a4e2dcaade0_0 .var "Q", 0 0;
E_0x5a4e2dc5fe70 .event anyedge, v0x5a4e2dcaad20_0, v0x5a4e2dc5f6e0_0;
    .scope S_0x5a4e2dc5f490;
T_0 ;
Ewait_0 .event/or E_0x5a4e2dc5fe70, E_0x0;
    %wait Ewait_0;
    %load/vec4 v0x5a4e2dcaad20_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %load/vec4 v0x5a4e2dc5f6e0_0;
    %assign/vec4 v0x5a4e2dcaade0_0, 0;
T_0.0 ;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x5a4e2dc98dc0;
T_1 ;
    %vpi_call/w 3 13 "$dumpfile", "d_latch.vcd" {0 0 0};
    %vpi_call/w 3 14 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5a4e2dc98dc0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4e2dcaafd0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4e2dcaaf00_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4e2dcaafd0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4e2dcaaf00_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4e2dcaafd0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4e2dcaaf00_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x5a4e2dcaafd0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4e2dcaaf00_0, 0, 1;
    %delay 10, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4e2dcaafd0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x5a4e2dcaaf00_0, 0, 1;
    %delay 10, 0;
    %vpi_call/w 3 29 "$finish" {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "d_latchtest.v";
    "d_latch.sv";
